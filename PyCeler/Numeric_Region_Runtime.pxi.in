                Changed[Slot] = <unsigned char*>FAST_PREFIXAllocate(Sizes[Slot])
                Trial_Changed[Slot] = <unsigned char*>FAST_PREFIXAllocate(Sizes[Slot])
                if DYNAMIC_IDENTITY:
