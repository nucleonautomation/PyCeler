                for Column in range(NUMERIC_PREFIXLength(Row_List)):
                    Cell = NUMERIC_PREFIXGet(Row_List, Column)
                    if Read_Input:
                        if INTEGER_READS:
                            if NUMERIC_PREFIXBoolean(<object>Cell):
                                Integer_Value = 1 if <object>Cell is True else 0
                            elif NUMERIC_PREFIXInteger(<object>Cell):
                                Integer_Value = NUMERIC_PREFIXLong_Value(<object>Cell, &Overflow)
                                if Overflow or Integer_Value < -1125899906842624 or Integer_Value > 1125899906842624:
                                    return None
                            else:
                                return None
                            Buffers[Slot][Position] = Integer_Value
                        elif not NUMERIC_PREFIXFloat(<object>Cell):
                            return None
                        else:
                            Buffers[Slot][Position] = <object>Cell
                        if not FAST_PREFIXFinite(Buffers[Slot][Position]):
                            return None
                    else:
                        if not (NUMERIC_PREFIXFloat(<object>Cell) or NUMERIC_PREFIXInteger(<object>Cell) or NUMERIC_PREFIXBoolean(<object>Cell) or <object>Cell is None):
                            return None
                        Buffers[Slot][Position] = 0.0
                    Position += 1
        if FAST_PREFIXGet_Environment(&Saved) != 0:
            return None
        try:
            FAST_PREFIXSignals()
            PARALLEL_COMPUTE
            if not Used_Parallel:
                NUMERIC_COMPUTE(Buffers, Changed, Shapes, Strides, Inputs, Origins, Owners, Sequence, Begin, Last, Step, Prefix_Assigned, &Valid, &Progress)
            if not Valid:
                if RECOVERABLE_FAILURES:
                    Failure[0] = Progress
                return None
            for Slot in range(BUFFER_COUNT):
                if BUFFER_WRITES[Slot]:
                    NUMERIC_PREFIXCopy(Trial[Slot], Buffers[Slot], Sizes[Slot] * sizeof(double))
            for Slot in range(SLOT_COUNT):
                Final_Inputs[Slot] = Inputs[Slot]
                Final_Origins[Slot] = Origins[Slot]
            NUMERIC_COMPUTE(Trial, Trial_Changed, Shapes, Strides, Final_Inputs, Final_Origins, Trial_Owners, Sequence, Last, End, Step, Assigned, &Valid, &Progress)
            Flags |= FAST_PREFIXTest_Exceptions(FAST_PREFIXAll_Exceptions)
        finally:
            FAST_PREFIXSet_Environment(&Saved)
        if not Valid:
            if RECOVERABLE_FAILURES:
                Failure[0] = Count - 1
            return None
        for Slot in REQUIRED_SLOTS:
            Valid = Valid and Assigned[Slot] != 0
        if not Valid:
            Recoverable = True
            if not Used_Parallel:
                for Slot in REQUIRED_SLOTS:
                    if not Assigned[Slot] and not Prefix_Assigned[Slot]:
                        Recoverable = False
            if RECOVERABLE_FAILURES and Recoverable:
                Failure[0] = Count - 1
            return None
        if Flags and FAST_PREFIXPrepare_Exceptions(Flags, &Prepared) != 0:
            return None
        Prepared_Outputs = []
        Boxed_Values = {}
        for Slot in range(BUFFER_COUNT):
            if not BUFFER_WRITES[Slot]:
                Prepared_Outputs.append(None)
                continue
            Boxed = [None] * Sizes[Slot]
            Integer_Output, Boolean_Output = BUFFER_INTEGER_OUTPUTS[Slot], BUFFER_BOOLEAN_OUTPUTS[Slot]
            for Position in range(Sizes[Slot]):
                if Changed[Slot][Position]:
                    if Boolean_Output:
                        Value = Buffers[Slot][Position] != 0.0
                    elif Integer_Output:
                        Value = <long long>Buffers[Slot][Position]
                    else:
                        if not DYNAMIC_IDENTITY:
                            NUMERIC_PREFIXRaw_Set(Boxed, Position, NUMERIC_PREFIXNew_Float(Buffers[Slot][Position]))
                            continue
                        Value = Buffers[Slot][Position]
                    if DYNAMIC_IDENTITY:
                        Owner = Owners[Slot][Position]
                        if Owner > 0:
                            Value = Boxed_Values.setdefault(Owner, Value)
                    NUMERIC_PREFIXStore(Boxed, Position, Value)
            Prepared_Outputs.append(Boxed)
        Carry_Updates = {}
        CARRY_UPDATES
        Pool = CONSTANT_PREFIXPool(Source_Code)
        Body = CONSTANT_PREFIXCode(NUMERIC_PREFIXBody, Pool)
        if not FAST_PREFIXExclusive() or not FAST_PREFIXBindings(Namespace):
            return None
        RECHECK_BUILTINS
        for Name, Global_Name in GLOBAL_BINDINGS:
            if Namespace.get(Name) is not Source_Globals.get(Global_Name):
                return None
        for Name in Absent_Names:
            if Name in Namespace:
                return None
        for Name, Value in Original_Names.items():
            if Namespace.get(Name) is not Value:
                return None
        for Matrix, Rows in Structures:
            if NUMERIC_PREFIXLength(Matrix) != NUMERIC_PREFIXLength(Rows):
                return None
            for Row in range(NUMERIC_PREFIXLength(Rows)):
                if NUMERIC_PREFIXGet(Matrix, Row) != NUMERIC_PREFIXGet(Rows, Row):
                    return None
        for Slot in range(BUFFER_COUNT):
            Rows = Row_Groups[Slot]
            if BUFFER_SHAPE_ONLY[Slot]:
                for Row_List in Rows:
