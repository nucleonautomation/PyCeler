from cpython.ref cimport Py_INCREF as NUMERIC_PREFIXRetain
# Buffer numeric list work and publish validated values with their required Python identities.
cdef extern from "Python.h":
    NUMERIC_PREFIXObject* NUMERIC_PREFIXNew_Float "PyFloat_FromDouble"(double Value) except NULL
    int NUMERIC_PREFIXRaw_Set "PyList_SetItem"(object Row, Py_ssize_t Position, NUMERIC_PREFIXObject* Value) except -1

cdef inline int NUMERIC_PREFIXStore(list Row, Py_ssize_t Position, object Value) except -1:
    NUMERIC_PREFIXRetain(Value)
    NUMERIC_PREFIXSet(Row, Position, Value)
    return 0

cdef inline int NUMERIC_PREFIXPublish(list Row, Py_ssize_t Position, list Boxed, Py_ssize_t Offset) except -1:
    cdef NUMERIC_PREFIXObject* Cell = NUMERIC_PREFIXGet(Boxed, Offset)
    NUMERIC_PREFIXRetain(<object>Cell)
    NUMERIC_PREFIXRaw_Set(Row, Position, Cell)
    return 0

def NUMERIC_PREFIXBlocks(Span, Recovery):
    import builtins as B
    if B.type(Span) is not B.range or not -1125899906842624 <= Span.start <= 1125899906842624 or not -1125899906842624 <= Span.stop <= 1125899906842624 or not -1125899906842624 <= Span.step <= 1125899906842624:
        yield Span
        return
    if B.len(Recovery) > 1:
        Recovery[1] = 2 * B.len(Span).bit_length()
    for Position in B.range(0, B.len(Span), BLOCK_SIZE):
        Pending = [(Span[Position:Position + BLOCK_SIZE], 0)]
        while Pending:
            Current, Depth = Pending.pop()
            Recovery[0] = 0
            yield Current
            Cut = Recovery[0]
            if 0 < Cut < B.len(Current):
                if Depth:
                    Cut = B.len(Current) // 2
                Pending.append((Current[Cut:], Depth + 1))
                Pending.append((Current[:Cut], Depth + 1))

cdef object NUMERIC_PREFIXTry(dict Namespace, object Span, object Whole, object Binding, object Length_Binding, object Policy, object Source_Code, dict Source_Globals, list Recovery):
    cdef bint Published = False
    cdef Py_ssize_t Failure = -1
    try:
        Result = NUMERIC_PREFIXAttempt(Namespace, Span, Whole, Binding, Length_Binding, Policy, Source_Code, Source_Globals, &Published, &Failure)
        if Result is None and Failure > 0:
            if len(Recovery) > 1:
                if Recovery[1] <= 0:
                    return None
                Recovery[1] -= 1
            Recovery[0] = Failure
        return Result
    except MemoryError:
        if Published:
            raise
        return None

cdef object NUMERIC_PREFIXAttempt(dict Namespace, object Span, object Whole, object Binding, object Length_Binding, object Policy, object Source_Code, dict Source_Globals, bint* Published, Py_ssize_t* Failure):
    import builtins as B
    cdef double* Buffers[BUFFER_COUNT]
    cdef double* Trial[BUFFER_COUNT]
    cdef unsigned char* Changed[BUFFER_COUNT]
    cdef unsigned char* Trial_Changed[BUFFER_COUNT]
    cdef Py_ssize_t* Shapes[BUFFER_COUNT]
    cdef Py_ssize_t* Strides[BUFFER_COUNT]
    cdef Py_ssize_t Shape_Data[BUFFER_COUNT * RANK_COUNT], Stride_Data[BUFFER_COUNT * RANK_COUNT], Sizes[BUFFER_COUNT]
    cdef double Inputs[SLOT_COUNT], Final_Inputs[SLOT_COUNT]
    cdef long long Origins[SLOT_COUNT], Final_Origins[SLOT_COUNT], Sequence[2], Series[256], Owner
    cdef long long* Owners[BUFFER_COUNT]
    cdef long long* Trial_Owners[BUFFER_COUNT]
    cdef Py_ssize_t Slot, Row, Column, Position, Height, Width, Total, Begin, End, Step, Last, Axis, Dimension
    cdef list Matrix, Rows, Row_List, Snapshot_Row, Boxed
    cdef bint Valid = True, Recoverable
    cdef unsigned char Assigned[SLOT_COUNT], Prefix_Assigned[SLOT_COUNT]
    cdef int Flags = 0, Overflow, Exceptions[256], Team[1], Workers, Mode
    cdef bint Checks[256], Used_Parallel = False, Parallel_OK
    cdef Py_ssize_t Count, Part, Parts, Chunk, Progress, Failures[256]
    cdef NUMERIC_PREFIXObject* Cell
    cdef long long Integer_Value
    cdef bint Integer_Output, Boolean_Output, Read_Input
    cdef FAST_PREFIXEnvironment Saved
    cdef FAST_PREFIXException_State Prepared
    global FAST_PREFIXNative_Elements, FAST_PREFIXParallel_Elements, FAST_PREFIXLast_Team
    Sequence[0], Sequence[1] = 0, 1
    _Pyceler_Dispatch_Event('Execution', 'python_fallback', 0)
    if Binding is not B.range or Length_Binding is not B.len or B.type(Span) is not B.range:  # Do not speculate through user-defined range or length callbacks.
        return None
    if B.type(Length_Binding) is not FAST_PREFIXTypes.BuiltinFunctionType or Length_Binding.__self__ is not B or Length_Binding.__name__ != 'len':
        return None
    if not -1125899906842624 <= Span.start <= 1125899906842624 or not -1125899906842624 <= Span.stop <= 1125899906842624 or not -1125899906842624 <= Span.step <= 1125899906842624 or B.len(Span) < 2:
        return None
    POLICY_GUARD
    if not FAST_PREFIXExclusive() or not FAST_PREFIXBindings(Namespace):
        return None
    REQUIRED_GUARDS
    Begin, End, Step, Last, Count = Span.start, Span.stop, Span.step, Span[-1], B.len(Span)
    Objects = [Namespace[Name] for Name in BUFFER_NAMES]
    Original_Names = {Name: Namespace[Name] for Name in OBSERVED_NAMES if Name in Namespace}
    Absent_Names = [Name for Name in OBSERVED_NAMES if Name not in Namespace]
    Row_Groups, Snapshots, Structures = [], [], []
    Identities = {}
    Total = 0
    for Slot in range(BUFFER_COUNT):
        Value = Objects[Slot]
        if not NUMERIC_PREFIXList(Value):
            return None
        Rows, Shape = [Value], []
        Height = 1
        for Axis in range(BUFFER_DIMENSIONS[Slot]):
            if not Rows or not NUMERIC_PREFIXList(Rows[0]):
                return None
            Dimension = B.len(Rows[0])
            if Dimension == 0 and not BUFFER_SHAPE_ONLY[Slot] or Dimension and Height > NUMERIC_PREFIXSize_Max // sizeof(double) // Dimension:
                return None
            Height *= Dimension
            Shape.append(Dimension)
            Next_Rows = []
            for Value in Rows:
                if not NUMERIC_PREFIXList(Value) or B.len(Value) != Dimension:
                    return None
                if not BUFFER_SHAPE_ONLY[Slot]:
                    Identity = B.id(Value)
                    if Identity in Identities and (Identities[Identity] or BUFFER_WRITES[Slot]):
                        return None
                    Identities[Identity] = BUFFER_WRITES[Slot]
                if Axis + 1 < BUFFER_DIMENSIONS[Slot]:
                    Structures.append((Value, list(Value)))
                    Next_Rows.extend(Value)
            if Axis + 1 < BUFFER_DIMENSIONS[Slot]:
                Rows = Next_Rows
        Sizes[Slot] = 0 if BUFFER_SHAPE_ONLY[Slot] else Height
        Shapes[Slot], Strides[Slot] = &Shape_Data[Slot * RANK_COUNT], &Stride_Data[Slot * RANK_COUNT]
        Position = 1
        for Axis in range(B.len(Shape) - 1, -1, -1):
            Shapes[Slot][Axis] = Shape[Axis]
            Strides[Slot][Axis] = Position
            Position *= Shape[Axis]
        Total = min(NUMERIC_PREFIXSize_Max - Sizes[Slot], Total) + Sizes[Slot]
        Row_Groups.append(Rows)
        Snapshots.append(None if BUFFER_SHAPE_ONLY[Slot] else [list(Value) for Value in Rows])
    for Slot in range(BUFFER_COUNT):
        Buffers[Slot] = NULL
        Trial[Slot] = NULL
        Changed[Slot] = NULL
        Trial_Changed[Slot] = NULL
        Owners[Slot] = NULL
        Trial_Owners[Slot] = NULL
    try:
        for Slot in range(BUFFER_COUNT):
            if BUFFER_SHAPE_ONLY[Slot]:
                continue
            Buffers[Slot] = <double*>FAST_PREFIXAllocate(Sizes[Slot] * sizeof(double))
            if BUFFER_WRITES[Slot]:
