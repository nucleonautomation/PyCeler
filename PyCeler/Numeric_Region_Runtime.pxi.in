                        return None
                continue
            for Row in range(B.len(Rows)):
                Row_List, Snapshot_Row = Rows[Row], Snapshots[Slot][Row]
                if NUMERIC_PREFIXLength(Row_List) != NUMERIC_PREFIXLength(Snapshot_Row):
                    return None
                for Column in range(NUMERIC_PREFIXLength(Row_List)):
                    if NUMERIC_PREFIXGet(Row_List, Column) != NUMERIC_PREFIXGet(Snapshot_Row, Column):
