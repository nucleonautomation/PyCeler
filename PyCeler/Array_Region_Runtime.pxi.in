cdef object NUMERIC_PREFIXTry(dict Namespace, object Span, object Whole, object Binding, object Length_Binding, object Policy, object Source_Code, dict Source_Globals, list Recovery=None):
    cdef bint Published = False
    cdef Py_ssize_t Failure = -1
    try:
        Result = NUMERIC_PREFIXAttempt(Namespace, Span, Whole, Binding, Length_Binding, Policy, Source_Code, Source_Globals, &Published, &Failure)
        if Result is None and Failure > 0 and Recovery is not None:  # Recover only a validated unpublished prefix; retries have a bounded budget.
            if len(Recovery) > 1:
                if Recovery[1] <= 0:
                    return None
                Recovery[1] -= 1
            Recovery[0] = Failure
        return Result
    except MemoryError:
        if Published:
            raise
        return None

cdef object NUMERIC_PREFIXAttempt(dict Namespace, object Span, object Whole, object Binding, object Length_Binding, object Policy, object Source_Code, dict Source_Globals, bint* Published, Py_ssize_t* Failure):
