        if Left is None:
            return None
        if Kind == "negative":
            Result = -Left[1], -Left[0]
        else:
            Right = _Pyceler_Reduction_Interval(Node[2], Values)
            if Right is None:
                return None
            if Kind == "add":
                Result = Left[0] + Right[0], Left[1] + Right[1]
            elif Kind == "subtract":
                Result = Left[0] - Right[1], Left[1] - Right[0]
            elif Kind == "multiply":
                Products = [A * C for A in Left for C in Right]
                Result = B.min(Products), B.max(Products)
            elif Right[0] <= 0 <= Right[1]:
                return None
            elif Kind == "modulo":
                Result = (0, Right[1] - 1) if Right[0] > 0 else (Right[0] + 1, 0)
            elif Kind == "floor":
                Quotients = [A // C for A in Left for C in Right]
                Result = B.min(Quotients), B.max(Quotients)
            else:
