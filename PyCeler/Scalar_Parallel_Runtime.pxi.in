    return Result if -9223372036854775808 <= Result[0] <= Result[1] <= 9223372036854775807 else None

cdef object _Pyceler_Reduction_Allowed(tuple Args, dict Plan):
    import builtins as B
    if B.any(B.type(Value) is not B.int or not -9223372036854775808 <= Value <= 9223372036854775807 for Value in Args):
        return None
    Values = B.tuple((Value, Value) for Value in Args)
    Begin = _Pyceler_Reduction_Interval(Plan["Begin"], Values)
    Stop = _Pyceler_Reduction_Interval(Plan["Stop"], Values)
    if Begin is None or Stop is None:
        return None
    Begin, Stop, Step = Begin[0], Stop[0], Plan["Step"]
    Count = B.max(0, (Stop - Begin + Step - 1) // Step) if Step > 0 else B.max(0, (Begin - Stop - Step - 1) // -Step)
    if not Count:
        return Begin, 0
    if Count > 9223372036854775807 or B.abs((Count - 1) * Step) > 9223372036854775807:
        return None
    Last = Begin + (Count - 1) * Step
    Term = _Pyceler_Reduction_Interval(Plan["Term"], (*Values, (B.min(Begin, Last), B.max(Begin, Last))))
    if Term is None:
        return None
    Low, High = Count * B.min(0, Term[0]), Count * B.max(0, Term[1])
    Initial = Plan["Initial"]
    if Low < -9223372036854775808 or High > 9223372036854775807 or Initial + Low < -9223372036854775808 or Initial + High > 9223372036854775807:
        return None
    return Begin, Count

